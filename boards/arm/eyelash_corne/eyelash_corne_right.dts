#include "eyelash_corne.dtsi"

&default_transform {
    col-offset = <7>;
};

/*
 * Azoteq IQS5xx (TPS65) touchpad -- RIGHT / peripheral half.
 *
 * Wired like the working LXF-YZP/zmk-config-rolio *master* branch (the config that
 * actually runs on this hardware; the tps65 branch's P0.15/P0.10 + RDY pull-down did
 * not):
 *   I2C0   SDA = P0.17,  SCL = P0.20      (400 kHz)
 *   RESET  = P1.01   (gpio1 1, active-low)
 *   RDY    = P1.02   (gpio1 2, active-high, no pull-down)
 *
 * P0.17/P0.20 are the display connector's pins: the LEFT half drives the vista508
 * display over SPI0 (SPIM0) on them; this half has no display, so we free SPI0 and
 * let I2C0 (TWIM0 -- the SAME nRF peripheral instance @0x40003000) own the pins.
 */

/* No display on this half: disable SPI0 so I2C0 can claim P0.17/P0.20. */
&nice_view_spi {
    status = "disabled";
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    /*
     * Legacy TWI (nordic,nrf-twi), NOT TWIM (EasyDMA), to match rolio EXACTLY.
     * rolio's &pro_micro_i2c resolves to nordic,nrf-twi @ 100 kHz. Forcing TWIM
     * here broke the touchpad the same way it broke the OLED: TWIM's EasyDMA cannot
     * transmit from flash/RODATA, so the Azoteq IQS5xx driver's const register
     * writes silently fail and the pad never comes up. Legacy TWI works (this is
     * why the touchpad only worked under rolio's firmware).
     */
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;   /* I2C_BITRATE_STANDARD (100 kHz), as rolio */

    tps43: iqs5xx@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        /* RESET / RDY: the pins that actually work on this hardware, taken from the
         * rolio MASTER branch (the tps65 pro_micro 21/16 = P0.15/P0.10 + RDY pull-down
         * did NOT work here). RESET = P1.01 (gpio1 1), RDY/INT = P1.02 (gpio1 2). */
        reset-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;    /* P1.01 */
        rdy-gpios   = <&gpio1 2 GPIO_ACTIVE_HIGH>;   /* P1.02 */

        /* Gestures the chip should report (rolio reference values). */
        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;

        scroll;
        natural-scroll-y;
        natural-scroll-x;

        /* Custom gestures (see driver Parts C & D). */
        zoom;                                  /* two-finger pinch-to-zoom */
        three-finger-swipe;                    /* three-finger swipe up -> launch app */
        three-finger-swipe-threshold = <80>;   /* tune: lower = more sensitive */

        /* Sensitivity (rolio reference values). */
        bottom-beta = <5>;
        stationary-threshold = <5>;

        /* Orientation -- adjust after first test (see guide section 9.3). */
        switch-xy;
    };
};

/* Peripheral side: forward this pointer device over the split link. */
&tps43_split {
    device = <&tps43>;
};
